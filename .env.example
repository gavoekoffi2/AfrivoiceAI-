# ============================================================================
# AfrivoiceAI — variables d'environnement
# Copiez ce fichier en .env.local et complétez les valeurs.
# ============================================================================

# --- Next.js / URL publique
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Auth + DB)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DATABASE_URL=postgresql://postgres:password@db.your_project.supabase.co:5432/postgres
# Sur Supabase (PgBouncer transaction mode) : 3-5 max. Sur Postgres self-hosted : 10-20.
DATABASE_POOL_MAX=3

# --- Auth interne (server-to-server) — générez avec: openssl rand -hex 32
INTERNAL_API_SECRET=change_me_to_a_long_random_string

# --- Vapi.ai (orchestration vocale)
VAPI_API_KEY=your_vapi_private_key
VAPI_PUBLIC_KEY=your_vapi_public_key
VAPI_WEBHOOK_SECRET=your_vapi_webhook_secret
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id

# --- ElevenLabs (TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# --- Google Gemini (LLM)
GEMINI_API_KEY=your_gemini_api_key

# --- Webhooks e-commerce
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret
WOOCOMMERCE_WEBHOOK_SECRET=your_woocommerce_webhook_secret

# --- Stripe (paiements)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Configuration métier
EXCHANGE_RATE_USD_TO_FCFA=600
PROFIT_MARGIN_PERCENTAGE=30

# --- Déploiement (docker-compose Nginx)
SERVER_NAME=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=afrivoice

# --- Observabilité
LOG_LEVEL=info
NEXT_PUBLIC_APP_VERSION=0.1.0
