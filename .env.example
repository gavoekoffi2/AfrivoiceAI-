# ------------------------------------------------------------
# AfrivoiceAI — Environment Variables
# Copy this file to .env.local and fill with real values.
# ------------------------------------------------------------

# Next.js Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AfrivoiceAI

# Internal secret (random, never expose — used for internal service-to-service calls)
# Generate with: openssl rand -hex 32
INTERNAL_WEBHOOK_SECRET=change-me-with-openssl-rand-hex-32

# Supabase (Database & Auth)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DATABASE_URL=postgresql://postgres:password@db.your_supabase_project.supabase.co:5432/postgres

# Vapi (Voice AI)
VAPI_API_KEY=your_vapi_private_key
VAPI_PUBLIC_KEY=your_vapi_public_key
VAPI_WEBHOOK_SECRET=your_vapi_webhook_secret
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id

# ElevenLabs (Text-to-Speech)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key

# Shopify Webhooks
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret

# WooCommerce Webhooks
WOOCOMMERCE_WEBHOOK_SECRET=your_woocommerce_webhook_secret

# Configuration Métier
EXCHANGE_RATE_USD_TO_FCFA=600
PROFIT_MARGIN_PERCENTAGE=30
LOW_BALANCE_THRESHOLD_FCFA=5000

# Stripe (paiements)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=your_stripe_public_key

# Rate Limiting (optionnel — Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
