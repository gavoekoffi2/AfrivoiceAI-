# AfrivoxAI — exemple de configuration
# Ne jamais mettre de vraies clés dans GitHub.
# Copier ce fichier en .env.local en local et configurer les mêmes variables dans Vercel/serveur.

# Next.js Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Database & Auth)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DATABASE_URL=postgresql://postgres:***@db.your_supabase_project.supabase.co:5432/postgres

# Vapi (Voice AI) — obligatoire pour lancer les appels réels
VAPI_API_KEY=your_vapi_private_key
VAPI_PUBLIC_KEY=your_vapi_public_key
VAPI_WEBHOOK_SECRET=your_vapi_webhook_secret
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id

# ElevenLabs (Text-to-Speech / voix premium)
# IMPORTANT: utiliser une voix française/francophone dans la Voice Library ElevenLabs.
# ELEVENLABS_FRENCH_VOICE_ID est prioritaire; ELEVENLABS_VOICE_ID reste accepté en fallback.
# Option A recommandée: configurer la clé ElevenLabs directement dans Vapi Provider Credentials / BYOK.
# Option B: garder ELEVENLABS_API_KEY côté serveur si on ajoute plus tard une intégration ElevenLabs directe.
ELEVENLABS_API_KEY=your_elevenlabs_key
ELEVENLABS_FRENCH_VOICE_ID=your_french_voice_id
ELEVENLABS_VOICE_ID=your_fallback_voice_id

# Google Gemini — utilisé par le modèle Vapi si provider Google/Gemini est activé
GEMINI_API_KEY=your_gemini_key

# Shopify Webhooks
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret

# WooCommerce Webhooks
WOOCOMMERCE_WEBHOOK_SECRET=your_woocommerce_webhook_secret

# Configuration Métier
EXCHANGE_RATE_USD_TO_FCFA=600
PROFIT_MARGIN_PERCENTAGE=30

# --- Sécurité Phase 0 ---
# Token DÉDIÉ pour les appels internes (webhook e-commerce -> /api/calls/initiate).
# NE PAS réutiliser SUPABASE_SERVICE_ROLE_KEY. Générer une valeur aléatoire >= 16 car.
INTERNAL_JOB_TOKEN=change_me_generate_a_long_random_token

# Mode démo OPT-IN et NON-admin (jamais sur un domaine public).
# Si non défini/false, aucune session n'est accordée sans authentification.
DEMO_MODE=false

# Modèle LLM de l'assistant Vapi (configurable, défaut = Gemini Flash actuel).
# La Partie B introduira la couche LLMProvider avec Claude (Haiku/Sonnet défaut,
# Fable/Opus en option).
VAPI_LLM_PROVIDER=google
VAPI_LLM_MODEL=gemini-1.5-flash
VAPI_LLM_TEMPERATURE=0.7

# Garde-fou financier : durée max d'un appel (secondes) pour éviter un wallet négatif.
CALL_MAX_DURATION_SECONDS=300

# Rétention des données personnelles d'appel par défaut (jours). Conformité
# loi togolaise n°2019-014. Surchargée par organisation (data_retention_days).
DATA_RETENTION_DAYS=90

# --- Pipeline vocal auto-hébergé (Parties B/C/E/F — voir INTEGRATION.md) ---
# LLM (cerveau conversationnel)
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=your_anthropic_key
LLM_MODEL_SIMPLE=claude-haiku-4-5
LLM_MODEL_DEFAULT=claude-sonnet-4-6
LLM_MODEL_PREMIUM=claude-opus-4-8

# STT — endpoint d'inférence Whisper (faster-whisper-server/speaches, MIT)
STT_PROVIDER=whisper
WHISPER_API_URL=
WHISPER_API_KEY=
WHISPER_MODEL=large-v3

# Traduction (fr <-> langues locales) par LLM — voir DATASETS.md (pas de
# modèle open commercial fiable ; NLLB est CC-BY-NC donc exclu).
TRANSLATION_PROVIDER=llm
TRANSLATION_MODEL=simple

# TTS — microservice OpenVoice V2 (MIT), endpoints /health /clone /tts
TTS_PROVIDER=openvoice
OPENVOICE_API_URL=
OPENVOICE_API_KEY=
OPENVOICE_CALLBACK_SECRET=

# Widget web embarquable (Partie E)
WIDGET_SESSION_SECRET=change_me_random_16_chars_min

# Téléphonie (Partie C — voir TELEPHONY.md)
TELEPHONY_PROVIDER=africas-talking
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_PHONE_NUMBER=
AFRICASTALKING_CALLBACK_TOKEN=change_me_random_16_chars_min
AFRICASTALKING_INBOUND_AGENT_ID=

# Stripe (paiements optionnel)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
